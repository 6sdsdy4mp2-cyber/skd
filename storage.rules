rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedInEmployee() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
          in ['employee1', 'employee2'];
    }
    function taskDoc(taskId) {
      return firestore.get(/databases/(default)/documents/tasks/$(taskId)).data;
    }
    function participant(taskId) {
      return signedInEmployee()
        && (
          taskDoc(taskId).createdBy == request.auth.uid
          || taskDoc(taskId).assignedTo == request.auth.uid
        );
    }

    match /tasks/{taskId}/original/{fileName} {
      allow read: if participant(taskId);
      allow create: if signedInEmployee()
        && taskDoc(taskId).createdBy == request.auth.uid
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'employee1'
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /tasks/{taskId}/processed/{fileName} {
      allow read: if participant(taskId);
      allow create: if signedInEmployee()
        && taskDoc(taskId).assignedTo == request.auth.uid
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'employee2'
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
